# Valores públicos del proyecto Supabase para los clientes del navegador y del servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secretos privados que usa Supabase local al servir las Edge Functions.
# Nunca uses el prefijo NEXT_PUBLIC_ para estas credenciales.
NUBEFACT_RUTA=
NUBEFACT_TOKEN=
NUBEFACT_AMBIENTE=
NUBEFACT_RUC_EMISOR=
NUBEFACT_PERMITIR_PRODUCCION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
