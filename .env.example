# Valores públicos del proyecto Supabase para los clientes del navegador y del servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Las credenciales privadas de NubeFacT y OpenAI no van en este archivo ni en
# variables NEXT_PUBLIC_. Para Supabase local, configura
# supabase/functions/.env.local desde supabase/functions/.env.example.
